{
  "name": "parkdex-operator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Parkdex operator dashboard. Deployed as its own Vercel project, preview-only, behind Vercel Authentication.",
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "vite --port 5191 --strictPort",

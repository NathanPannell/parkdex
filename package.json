{
  "name": "parkdex-badge-mockup",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "dev": "vite --port 5190",
    "build": "vite build",
    "preview": "vite preview --port 5190",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "map": "node scripts/fetch-map.mjs",
    "art": "python scripts/optimize-art.py",
    "build:field": "node scripts/copy-maplibre-worker.mjs && vite build --mode field",
    "android:sync": "npm run build:field && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "drive": "node scripts/drive-times.mjs",
    "android:aab": "npm run android:sync && cd android && gradlew.bat bundleRelease",
    "test": "tsx --test worker/*.test.ts && tsx scripts/preview-feedback-emails.ts",
    "email:preview": "tsx scripts/preview-feedback-emails.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.1",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.2",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "@protomaps/basemaps": "^5.7.2",
    "@vercel/functions": "^3.9.9",
    "canvas-confetti": "^1.9.4",
    "html-to-image": "^1.11.13",
    "maplibre-gl": "^6.11.2",
    "motion": "^13.4.4",
    "pmtiles": "^4.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vercel/node": "^16.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "puppeteer-core": "^25.12.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.1"
  }
}

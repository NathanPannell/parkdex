# Local Postgres (the compose default; a direct connection is fine locally)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/app
FRONTEND_ORIGINS=http://localhost:3000
APP_COMMIT_SHA=local
CHECK_INTERVAL_SECONDS=180
REQUEST_TIMEOUT_SECONDS=10
APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
MCP_PUBLIC_URL=http://localhost:8000/mcp
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Parkdex <no-reply@parkdex.app>
SMTP_USE_TLS=true
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
RESEND_FROM=Parkdex <no-reply@parkdex.app>
